<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.buildandserve.projects-db-cert-watch</string>

  <!-- Every project database URL is sslmode=verify-full against a 90-day Let's
       Encrypt cert (LAC-6054). A renewal that stops working is a simultaneous
       hard outage for every project on the box, with no partial degradation to
       notice first. This is the only thing watching for that.
       Scheduled by launchd, not by a Paperclip routine: the box this watches
       also carries the BAS control plane, so a routine could be unable to run
       for the same reason the check would have fired.
       Runbook: ~/repo/buildandserve/docs/ops/bas-projects-db.md -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/lacy/repo/buildandserve/scripts/bas-projects-db-cert-watch.sh</string>
    <string>--notify</string>
  </array>

  <!-- Daily at 09:00 local. The threshold is 21 days remaining, so a daily
       cadence has three weeks of runway to reach somebody; anything more
       frequent buys nothing and only adds ways to be noisy. launchd runs a
       missed calendar job on wake, which is what makes this survive a closed
       lid overnight. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <!-- Silence means healthy: the script prints nothing and exits 0 when the
       cert is fine, so a growing log file is itself a signal. Exit 3 means the
       run proved nothing (this host could not do DNS) and is not an incident. -->
  <key>StandardOutPath</key>
  <string>/Users/lacy/.paperclip/logs/projects-db-cert-watch.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/lacy/.paperclip/logs/projects-db-cert-watch.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
